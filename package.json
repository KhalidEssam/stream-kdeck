{
  "name": "control-surface-platform",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "agent": "npm run dev --workspace=apps/agent",
    "mobile": "npm run start --workspace=apps/mobile",
    "web": "npm run dev --workspace=apps/web",
    "web:build": "npm run build --workspace=apps/web",
    "test": "npm run test --workspaces --if-present"
  },
  "devDependencies": {
    "@types/jest": "^30.0.0"
  }
}
