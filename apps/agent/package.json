{
  "name": "@control-surface/agent",
  "version": "0.1.0",
  "private": true,
  "description": "KDeck Agent – tray app bridging KDeck to NestJS backend",
  "author": "KDeck",
  "main": "dist/main.js",
  "scripts": {
    "dev": "tsc --build && electron .",
    "build": "tsc --build",
    "test": "jest --runInBand",
    "dist": "tsc --build && node scripts/build-release.js",
    "dist:win": "tsc --build && node scripts/build-release.js --win",
    "dist:win:preview": "tsc --build && node scripts/build-release.js --win --channel preview",
    "dist:mac": "tsc --build && node scripts/build-release.js --mac",
    "dist:mac:preview": "tsc --build && node scripts/build-release.js --mac --channel preview",
    "postinstall": "node scripts/rebuild-native.js"
  },
  "dependencies": {
    "@nestjs/common": "^10.0.0",
    "@nestjs/core": "^10.0.0",
    "@nestjs/platform-ws": "^10.0.0",
    "@nestjs/websockets": "^10.0.0",
    "@nut-tree-fork/nut-js": "^4.2.6",
    "@supabase/supabase-js": "^2.105.4",
    "active-win": "^7.7.2",
    "bonjour-service": "^1.3.0",
    "clipboardy": "^3.0.0",
    "dotenv": "^17.4.2",
    "electron-updater": "^6.8.3",
    "node-audio-volume-mixer": "^1.0.3",
    "reflect-metadata": "^0.2.0",
    "rxjs": "^7.8.0",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@electron/rebuild": "^4.0.4",
    "@nestjs/platform-express": "^11.1.21",
    "@nestjs/testing": "^11.1.21",
    "@types/jest": "^29.0.0",
    "@types/node": "^20.0.0",
    "@types/ws": "^8.5.0",
    "electron": "^31.7.7",
    "electron-builder": "^25.1.8",
    "jest": "^29.0.0",
    "ts-jest": "^29.0.0",
    "ts-node": "^10.9.0",
    "typescript": "^5.4.0"
  },
  "build": {
    "appId": "com.kdeck.agent",
    "productName": "KDeck Agent",
    "copyright": "Copyright © 2026 KDeck",
    "electronVersion": "31.7.7",
    "directories": {
      "output": "release"
    },
    "npmRebuild": false,
    "electronUpdaterCompatibility": ">=2.16",
    "publish": [
      {
        "provider": "generic",
        "url": "${env.KDECK_AGENT_UPDATE_BASE_URL}",
        "channel": "${env.KDECK_AGENT_UPDATE_CHANNEL}"
      }
    ],
    "files": [
      "dist/**/*",
      "assets/**/*",
      ".env",
      "package.json",
      "node_modules/**/*"
    ],
    "asar": false,
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "assets/icon-256.png"
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "createDesktopShortcut": false,
      "createStartMenuShortcut": true
    },
    "mac": {
      "category": "public.app-category.utilities",
      "target": [
        {
          "target": "dmg",
          "arch": [
            "x64",
            "arm64"
          ]
        }
      ],
      "icon": "assets/icon.png",
      "extendInfo": {
        "LSUIElement": true
      }
    }
  }
}
