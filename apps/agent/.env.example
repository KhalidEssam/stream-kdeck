# Gemini — free tier: 1M tokens/day
# Get key at https://aistudio.google.com/app/apikey (no credit card required)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Supabase — required for license activation and session refresh (always needed, not secret)
# Project Settings > API  (anon/publishable key — safe to ship)
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key
# Note: after activation the refresh token is stored in the OS keychain via Electron safeStorage,
# not in this file. These two vars are the only agent secrets that need to be in .env.
