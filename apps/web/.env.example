NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Paymob
PAYMOB_BASE_URL=https://accept.paymob.com
PAYMOB_SECRET_KEY=your-paymob-secret-key
# Optional: auth scheme prefix for the Authorization header. Defaults to "Token".
# PAYMOB_AUTH_SCHEME=Token
NEXT_PUBLIC_PAYMOB_PUBLIC_KEY=your-paymob-public-key
PAYMOB_HMAC_SECRET=your-paymob-hmac-secret
# Dashboard > Developers > Payment Integrations. Use the ID from the same Paymob mode/account as PAYMOB_SECRET_KEY.
PAYMOB_CARD_INTEGRATION_ID=your-paymob-card-integration-id
PAYMOB_CURRENCY=USD
PAYMOB_LICENSE_AMOUNT_CENTS=1900
PAYMOB_AI_PRO_MONTHLY_AMOUNT_CENTS=800
PAYMOB_AI_PRO_YEARLY_AMOUNT_CENTS=5900
# Override when Paymob gives you a region-specific unified checkout URL.
PAYMOB_CHECKOUT_URL_TEMPLATE=https://accept.paymob.com/unifiedcheckout/?publicKey={publicKey}&clientSecret={clientSecret}
# Optional. If omitted, dashboard cancellation marks the local subscription cancelled only.
# PAYMOB_SUBSCRIPTION_CANCEL_URL_TEMPLATE=https://accept.paymob.com/api/subscriptions/{subscriptionId}/cancel

# Supabase service role is server-only. Never expose it with NEXT_PUBLIC_.
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key
SUPABASE_JWT_SECRET=your-supabase-jwt-secret
LICENSE_KEY_SECRET=generate-a-long-random-secret-for-license-key-derivation

# Optional transactional email. If omitted in development, the license key is logged server-side.
RESEND_API_KEY=
EMAIL_FROM=Control Surface <licenses@your-domain.com>
