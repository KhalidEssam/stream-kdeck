NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Paymob
PAYMOB_BASE_URL=https://accept.paymob.com
PAYMOB_SECRET_KEY=your-paymob-secret-key
# Optional: auth scheme prefix for the Authorization header. Defaults to "Token".
# PAYMOB_AUTH_SCHEME=Token
NEXT_PUBLIC_PAYMOB_PUBLIC_KEY=your-paymob-public-key
PAYMOB_HMAC_SECRET=your-paymob-hmac-secret
# Dashboard > Developers > Payment Integrations. Use the ID from the same Paymob mode/account as PAYMOB_SECRET_KEY.
PAYMOB_CARD_INTEGRATION_ID=your-paymob-card-integration-id
PAYMOB_CURRENCY=USD
PAYMOB_LICENSE_AMOUNT_CENTS=1900
PAYMOB_AI_PRO_MONTHLY_AMOUNT_CENTS=800
PAYMOB_AI_PRO_YEARLY_AMOUNT_CENTS=5900
# Override when Paymob gives you a region-specific unified checkout URL.
PAYMOB_CHECKOUT_URL_TEMPLATE=https://accept.paymob.com/unifiedcheckout/?publicKey={publicKey}&clientSecret={clientSecret}
# Optional. If omitted, dashboard cancellation marks the local subscription cancelled only.
# PAYMOB_SUBSCRIPTION_CANCEL_URL_TEMPLATE=https://accept.paymob.com/api/subscriptions/{subscriptionId}/cancel

# Supabase service role is server-only. Never expose it with NEXT_PUBLIC_.
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key
# Project Settings > API > JWT Secret > Reveal
SUPABASE_JWT_SECRET=your-supabase-jwt-secret
LICENSE_KEY_SECRET=generate-a-long-random-secret-for-license-key-derivation

# Optional transactional email. If omitted in development, the license key is logged server-side.
RESEND_API_KEY=
EMAIL_FROM=KDeck <licenses@your-domain.com>

# Cloud integration OAuth framework
# Required when any OAuth plugin is active. Generate with: openssl rand -hex 32
OAUTH_TOKEN_ENCRYPTION_KEY=your-64-hex-char-aes-256-key

# OAuth provider credentials — only required when the matching plugin is enabled.
# Leave blank to disable that provider; the plugin will error cleanly at OAuth start.

# Twitch — https://dev.twitch.tv/console/apps
TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=

# Spotify — https://developer.spotify.com/dashboard
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=

# YouTube (Google OAuth) — https://console.cloud.google.com/apis/credentials
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=

# TikTok — https://developers.tiktok.com/apps
TIKTOK_CLIENT_ID=
TIKTOK_CLIENT_SECRET=

# Kick — https://kick.com/settings/developer (PKCE only, no client secret needed)
KICK_CLIENT_ID=

# Linear — https://linear.app/settings/api
LINEAR_CLIENT_ID=
LINEAR_CLIENT_SECRET=

# Notion — https://www.notion.so/my-integrations
NOTION_CLIENT_ID=
NOTION_CLIENT_SECRET=

# Slack — https://api.slack.com/apps
SLACK_CLIENT_ID=
SLACK_CLIENT_SECRET=

# GitHub — https://github.com/settings/developers
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
